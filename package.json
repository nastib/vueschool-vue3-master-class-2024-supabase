{
  "name": "vueschool-vue3-master-class-2024-supabase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "supabase:init": "npx supabase init",
    "supabase:login": "npx supabase login",
    "supabase:link": "npx supabase link --project-ref nyeiguokfrmnztqeyyzz --password",
    "db:migration:new": "npx supabase migration new schema-*****",
    "db:migration:list": "npx supabase migration list",
    "db:push": "npx supabase db push  --linked",
    "db:pull": "npx supabase db push  --linked",
    "db:seed": "node --env-file=.env database/seed.js",
    "db:reset": "npx supabase db reset --linked",
    "gen:types": "npx supabase gen types --lang=typescript --project-id  nyeiguokfrmnztqeyyzz --schema public > database/types.ts"
  },
  "dependencies": {
    "@radix-icons/vue": "^1.0.0",
    "@supabase/supabase-js": "^2.43.4",
    "@tanstack/vue-table": "^8.20.5",
    "@vueuse/core": "^11.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "iconify-icon": "^2.1.0",
    "lucide-vue-next": "^0.437.0",
    "pinia": "^2.1.7",
    "radix-vue": "^1.9.5",
    "reka-ui": "^2.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.5.13",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@nuxt/content": "^2.13.2",
    "@nuxt/devtools": "^2.1.0",
    "@rushstack/eslint-patch": "^1.8.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^20.14.5",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.4.0",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.21.0",
    "eslint-plugin-vue": "^9.32.0",
    "npm-run-all2": "^6.2.0",
    "prettier": "^3.5.3",
    "supabase": ">=1.8.1",
    "tailwindcss": "^3.4.10",
    "typescript": "~5.8.2",
    "unplugin-auto-import": "^0.18.2",
    "unplugin-vue-components": "^0.27.4",
    "unplugin-vue-router": "^0.10.0",
    "vite": "^5.3.1",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.8"
  }
}
